{
  "manifest_version": 3,
  "name": "Amnezia Browser",
  "version": "1",
  "description": "Amnezia Premium only for selected browser sites",
  "key": "",
  "permissions": [
    "activeTab",
    "storage",
    "proxy",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:9090/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Amnezia Browser"
  }
}
